BACKEND_URL=http://localhost:9000
STOREFRONT_URL=http://localhost:8000
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:7000,http://localhost:7001
AUTH_CORS=http://localhost:7000,http://localhost:7001
REDIS_URL=redis://localhost:6379
# IMPORTANTE: genera un valor único con: openssl rand -hex 32
# Nunca uses "supersecret" en producción
JWT_SECRET=supersecret
# IMPORTANTE: genera un valor único con: openssl rand -hex 32
# Nunca uses "supersecret" en producción
COOKIE_SECRET=supersecret
DATABASE_URL=postgresql://postgres:postgres123@localhost:5433/medusa
STRIPE_API_KEY=

# minio
S3_FILE_URL=http://localhost:9090/medusa
S3_ACCESS_KEY_ID=medusaminio
S3_SECRET_ACCESS_KEY=medusaminio
S3_REGION=us-east-1
S3_BUCKET=medusa
S3_ENDPOINT=http://localhost:9090
S3_FORCE_PATH_STYLE=true

# resend
RESEND_API_KEY=
RESEND_FROM="Tu Tienda <noreply@tutienda.com>"

# reply-to de los emails transaccionales (ej: contact@tudominio.com).
# Vacío = sin reply-to. Al tener dominio, apúntalo aquí para que las
# respuestas de los clientes lleguen al buzón del comerciante.
EMAIL_REPLY_TO=

# buzón del comerciante: recibe un aviso por cada pedido nuevo.
# Vacío = NO se envía el aviso. Es la única señal automática de que hay un
# pedido que preparar: la campanita del admin no notifica pedidos.
MERCHANT_NOTIFICATION_EMAIL=

# sentry — vacío = desactivado (no-op, no requiere configuración en local).
# Necesario para enterarse de los fallos de envío de email: el código los
# captura y no los relanza, así que sin esto solo quedan en el log.
SENTRY_DSN=

# brevo — alternativa a resend, INACTIVO hasta activarlo en medusa-config.js
BREVO_API_KEY=
BREVO_FROM="Tu Tienda <noreply@tutienda.com>"
