# ── MARCA ────────────────────────────────────────────────────────────────
# Nombre de la tienda tal y como aparece en TODOS los emails transaccionales
# (asuntos, cuerpo, cabecera y pie). Cambiarlo aquí basta: no hay ni un
# nombre escrito a mano dentro de las plantillas.
# El nombre del STOREFRONT se configura aparte, en storefront/src/lib/brand.ts
STORE_NAME=Mi Tienda

BACKEND_URL=http://localhost:9000
STOREFRONT_URL=http://localhost:8000
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:7000,http://localhost:7001
AUTH_CORS=http://localhost:7000,http://localhost:7001
# OBLIGATORIA. Redis sostiene la caché, el bus de eventos y el motor de
# workflows (ver medusa-config.js). Sin esta variable Medusa NO arranca, y es
# a propósito: la alternativa era caer en silencio a memoria volátil y perder
# eventos —emails de pedido incluidos— en cada reinicio.
# En local la levanta docker-compose. En producción, el servicio de Coolify.
REDIS_URL=redis://localhost:6379
# Secretos de firma de sesiones y tokens. Estos valores valen SOLO para local.
# En producción (NODE_ENV=production) Medusa se niega a arrancar si siguen
# puestos en "supersecret" o si tienen menos de 32 caracteres — ver
# `resolveSigningSecret` en medusa-config.js. Es a propósito: con un secreto
# conocido cualquiera puede fabricarse un JWT de administrador.
# Genera uno distinto para cada variable con: openssl rand -hex 32
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=postgresql://postgres:postgres123@localhost:5433/medusa

# stripe — la clave secreta (sk_...) de la cuenta del cliente
STRIPE_API_KEY=
# Firma de los webhooks de Stripe. Se copia al crear el endpoint en
# Stripe → Developers → Webhooks; empieza por "whsec_".
# OBLIGATORIA en producción: sin ella la verificación de firma lanza excepción
# y Stripe no puede confirmar los cobros, así que los pedidos se quedan
# colgados sin pagar. En local se puede dejar vacía si no pruebas webhooks.
STRIPE_WEBHOOK_SECRET=

# minio
S3_FILE_URL=http://localhost:9090/medusa
S3_ACCESS_KEY_ID=medusaminio
S3_SECRET_ACCESS_KEY=medusaminio
S3_REGION=us-east-1
S3_BUCKET=medusa
S3_ENDPOINT=http://localhost:9090
S3_FORCE_PATH_STYLE=true

# resend
RESEND_API_KEY=
RESEND_FROM="Tu Tienda <noreply@tutienda.com>"

# reply-to de los emails transaccionales (ej: contact@tudominio.com).
# Vacío = sin reply-to. Al tener dominio, apúntalo aquí para que las
# respuestas de los clientes lleguen al buzón del comerciante.
EMAIL_REPLY_TO=

# buzón del comerciante: recibe un aviso por cada pedido nuevo.
# Vacío = NO se envía el aviso. Es la única señal automática de que hay un
# pedido que preparar: la campanita del admin no notifica pedidos.
MERCHANT_NOTIFICATION_EMAIL=

# sentry — vacío = desactivado (no-op, no requiere configuración en local).
# Necesario para enterarse de los fallos de envío de email: el código los
# captura y no los relanza, así que sin esto solo quedan en el log.
SENTRY_DSN=

# brevo — alternativa a resend, INACTIVO hasta activarlo en medusa-config.js
BREVO_API_KEY=
BREVO_FROM="Tu Tienda <noreply@tutienda.com>"
