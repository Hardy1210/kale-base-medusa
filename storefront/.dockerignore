# Todo lo que no debe entrar en el contexto de build.
# Sin esto, Docker envía cientos de MB al daemon en cada despliegue y unos
# node_modules construidos en Windows acabarían dentro de una imagen Linux.

node_modules
.next
out
build
.swc

# Secretos. Nunca deben quedar horneados en una capa de la imagen: las
# variables las inyecta Coolify (y las NEXT_PUBLIC_*, como build args).
.env
.env.*
!.env.template

.git
.gitignore
.github

